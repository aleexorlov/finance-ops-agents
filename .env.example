# Copy to .env and fill in. .env is gitignored: never commit it, never paste keys into chat.

# Agent A and the evaluation script. Create a key at platform.claude.com.
ANTHROPIC_API_KEY=
# Optional: override the model Agent A uses.
FINANCE_OPS_MODEL=claude-sonnet-5-5

# The MCP server's HTTP transport (Docker, Cloud Run, ElevenAgents) refuses to
# start without this. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Only for the voice agent setup script.
ELEVENLABS_API_KEY=
